lass] = \"COGS\")","formatString":"#,##0 €","displayFolder":"02 - Gastos"},{"name":"OpEx Variance","lineageTag":"5b3f1388b93c","expression":"[Total OpEx] - [Total OpEx Budget]","formatString":"#,##0 €","displayFolder":"02 - Gastos"},{"name":"OpEx Variance %","lineageTag":"888aa4648157","expression":"DIVIDE([OpEx Variance], [Total OpEx Budget], 0)","formatString":"+0.0%;-0.0%;0.0%","displayFolder":"02 - Gastos"},{"name":"Payroll","lineageTag":"0912482d4306","expression":"CALCULATE(SUM(FactActuals[Amount]), DimAccount[AccountCode] = \"501000\")","formatString":"#,##0 €","displayFolder":"02 - Gastos"},{"name":"Payroll % Revenue","lineageTag":"ef598e878b6f","expression":"DIVIDE([Payroll], [Total Revenue], 0)","formatString":"0.0%","displayFolder":"02 - Gastos"},{"name":"Food Cost %","lineageTag":"e54243621b8a","expression":"VAR FC = CALCULATE(SUM(FactActuals[Amount]), DimAccount[AccountCode] = \"509000\")\nVAR FNB = [Revenue F&B]\nRETURN DIVIDE(FC, FNB, 0)","formatString":"0.0%","displayFolder":"02 - Gastos"},{"name":"GOP","lineageTag":"8436d8c692a6","expression":"[Total Revenue] - [Total OpEx]","formatString":"#,##0 €","displayFolder":"03 - GOP"},{"name":"GOP Budget","lineageTag":"4d95ebce32f7","expression":"[Total Revenue Budget] - [Total OpEx Budget]","formatString":"#,##0 €","displayFolder":"03 - GOP"},{"name":"GOP Variance","lineageTag":"de079ce13117","expression":"[GOP] - [GOP Budget]","formatString":"#,##0 €","displayFolder":"03 - GOP"},{"name":"GOP Margin","lineageTag":"b7f45b4c5faa","expression":"DIVIDE([GOP], [Total Revenue], 0)","formatString":"0.0%","displayFolder":"03 - GOP"},{"name":"GOP Margin Budget","lineageTag":"b644ab41cde5","expression":"DIVIDE([GOP Budget], [Total Revenue Budget], 0)","formatString":"0.0%","displayFolder":"03 - GOP"},{"name":"GOP Margin Variance","lineageTag":"acefb9cfcecf","expression":"[GOP Margin] - [GOP Margin Budget]","formatString":"+0.0%;-0.0%","displayFolder":"03 - GOP"},{"name":"EBITDA","lineageTag":"076d434c5265","expressi